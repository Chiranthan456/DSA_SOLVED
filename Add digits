class Solution {
public:
    int addDigits(int num) {
        int sum=0,count=0;
        if(num == 0){
            return 0;
        }
        while(num !=0){
            int digit = num % 10;
            sum += digit;
            num /=10;
            count++;
        }
        if(count == 1){
            return sum;
        }else{
            return addDigits(sum);
        }
    }
};
