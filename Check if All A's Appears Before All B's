class Solution {
public:
    bool checkString(string s) {
        if(s.size() == 1){
            return true;
        }
        for(int i=0;i<s.size()-1;i++){
            int first = s[i] - 'a';
            int second = s[i+1] - 'a';

            int diff = first - second;
            if(diff == 1){
                return false;
            }
        }
        return true;
    }
};
