class Solution {
public:

    bool hasValidPath(vector<vector<char>>& grid) {

        int m = grid.size();
        int n = grid[0].size();

        int len = m + n - 1;

        // Length must be even
        if (len % 2 == 1)
            return false;

        // Start must be '('
        if (grid[0][0] == ')')
            return false;

        // End must be ')'
        if (grid[m - 1][n - 1] == '(')
            return false;

        vector<vector<vector<bool>>> dp(
            m,
            vector<vector<bool>>(
                n,
                vector<bool>(len + 1, false)
            )
        );

        // Starting cell
        dp[0][0][1] = true;

        for (int i = 0; i < m; i++) {

            for (int j = 0; j < n; j++) {

                // Skip starting cell
                if (i == 0 && j == 0)
                    continue;

                for (int balance = 0; balance <= len; balance++) {

                    int newBalance;

                    if (grid[i][j] == '(')
                        newBalance = balance + 1;
                    else
                        newBalance = balance - 1;

                    // Current balance cannot be negative
                    if (newBalance < 0)
                        continue;

                    // From top
                    if (i > 0 &&
                        dp[i - 1][j][balance]) {

                        dp[i][j][newBalance] = true;
                    }

                    // From left
                    if (j > 0 &&
                        dp[i][j - 1][balance]) {

                        dp[i][j][newBalance] = true;
                    }
                }
            }
        }

        return dp[m - 1][n - 1][0];
    }
};
