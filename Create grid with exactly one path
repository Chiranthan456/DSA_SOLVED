class Solution {
public:
    vector<string> createGrid(int m, int n) {
        //Make the first row and last row from # to . bcz that is the valid path
        vector<string> grid(m, string(n, '#'));

        for (int j = 0; j < n; j++) {
            grid[0][j] = '.';
        }

        for (int i = 0; i < m; i++) {
            grid[i][n - 1] = '.';
        }

        return grid;
    }
};
