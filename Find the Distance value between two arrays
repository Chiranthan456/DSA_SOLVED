class Solution {
public:
    int findTheDistanceValue(vector<int>& arr1, vector<int>& arr2, int d) {
        int n = arr1.size(),m = arr2.size();
        int anscount=0;
        for(int i=0;i<n;i++){
            int first = arr1[i];
            int count=0;
            for(int j=0;j<m;j++){
                int second = arr2[j];

                if(abs(first - second) > d){
                    count++;
                }
            }
            if(count == m){
                anscount++;
            }
        }

        return anscount;
    }
};
