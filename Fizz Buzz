class Solution {
public:
    vector<string> fizzBuzz(int n) {
        vector<string> s;

        for(int i=1;i<=n;i++){
            s.push_back(to_string(i));
        }

        for(int i=0;i<s.size();i++){
            if((i+1)%3==0 && (i+1)%5==0){
                s[i] = "FizzBuzz";
            }
            if((i+1)%3==0 && (i+1)%5!=0){
                s[i] = "Fizz";
            }
            if((i+1)%3!=0 && (i+1)%5==0){
                s[i] = "Buzz";
            }
        }
        return s;
    }
};
