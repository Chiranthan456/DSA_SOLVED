class Solution {
public:
    bool isSubsequence(string s, string t) {
        int i=0,j=0;
        int s1= s.size(),t1 = t.size();
        int count=0;
        while(i<s1 && j<t1){
            if(s[i] == t[j]){
                i++;
                j++;
                count++;
            }else{
                j++;
            }
        }
        if(count == s.size()){
            return true;
        }
        return false;
    }
};
