class Solution {
public:
    int minMoves2(vector<int>& nums) {
        
        sort(nums.begin(),nums.end());

        int n = nums.size();
        int l=0,r=n-1,count=0;
        int diff=0;
        int mid = l + (r-l) / 2;
        if(n == 1){
            return 0;
        }
        for(int i=0;i<n;i++){
            diff = abs(nums[mid] - nums[i]);
            count += diff;
        }
        return count;
    }
};
