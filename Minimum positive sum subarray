class Solution {
public:
    int minimumSumSubarray(vector<int>& nums, int l, int r) {
        int n = nums.size();
        int minv = INT_MAX;

        for(int i=0;i<n;i++){
            int sum=0;

            for(int j=i;j<n;j++){

                sum += nums[j];
                int len = j-i+1;

                if(sum >0){
                    if(len>=l && len<=r){
                        minv = min(minv,sum);
                    }
                }
            }
        }
        if(minv == INT_MAX){
            return -1;
        }
        else
            return minv;
    }
};
