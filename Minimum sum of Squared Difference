class Solution {
public:
    long long minSumSquareDiff(vector<int>& nums1, vector<int>& nums2,
                               int k1, int k2) {
        long long k = 1LL * k1 + k2;
        vector<long long> diff;
        long long total = 0, maxDiff = 0;

        for (int i = 0; i < nums1.size(); i++) {
            long long d = abs(nums1[i] - nums2[i]);
            diff.push_back(d);
            total += d;
            maxDiff = max(maxDiff, d);
        }

        if (k >= total) return 0;

        // Find the minimum possible maximum difference.
        long long low = 0, high = maxDiff;

        while (low < high) {
            long long mid = low + (high - low) / 2;
            long long needed = 0;

            for (long long d : diff) {
                if (d > mid)
                    needed += d - mid;
            }

            if (needed <= k)
                high = mid;
            else
                low = mid + 1;
        }

        long long limit = low;
        long long used = 0;
        long long ans = 0;

        for (long long d : diff) {
            if (d > limit)
                used += d - limit;
        }

        long long remaining = k - used;

        for (long long d : diff) {
            d = min(d, limit);

            // Use leftover operations to reduce limit to limit - 1.
            if (d == limit && remaining > 0) {
                d--;
                remaining--;
            }

            ans += d * d;
        }

        return ans;
    }
};
