class Solution {
public:
    int hammingWeight(int n) {
        string bitn = std::bitset<32>(n).to_string();

        int size1 = bitn.size();
        int count=0;
        for(int i=0;i<size1;i++){
            if(bitn[i] == '1'){
                count++;
            }else{
                continue;
            }
        }

        return count;
    }
};
