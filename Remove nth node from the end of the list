/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        if (head == NULL){
            return NULL;
        }
        int count=0,size=0;
        ListNode* temp = head;
        while(temp != NULL){
            temp = temp->next;
            size++;
        }

        if(n == size){
            ListNode* del = head;
            head = head->next;
            delete del;
            return head;
        }
        
        temp = head;
        while(temp != NULL){
            count++;
            if(count == size+1-n)
                break;
            temp = temp->next;
        }
        ListNode* prev = head;
        while(prev->next != temp){
            prev = prev->next;
        }

        prev->next = temp ->next;
        delete(temp);

        return head;
    }
};
