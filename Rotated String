class Solution {
public:
    bool rotateString(string s, string goal) {
        
        if (s.length() != goal.length()) {
            return false;
        }

        string temp = s + s;

        int position = temp.find(goal);

        bool found = false;

        if (position != string::npos) {
            found = true;
        }

        return found;
    }
};
