class Solution {
public:
    bool isPerfectSquare(int num) {
        if(num==0){
            return true;
        }
        
        if(num==1){
            return true;
        }
        if(num==4){
            return true;
        }
        for(long long i=2;i<num/2;i++){
            long long square = i*i;
            if(square == num){
                return true;
            }
        }
        return false;
    }
};
