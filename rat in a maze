class Solution {
  public:
    void getAns(vector<vector<int>>& maze,int row,int col,string path,vector<string>& ans){
        int n=maze.size();
        
        if(row < 0 || col <0 || row >=n || col >= n){
            return ;
        }
        
        if( maze[row][col] == 0 || maze[row][col] == -1){
            return ;
        }
        
        if(row == n-1 && col == n-1){
            ans.push_back(path);
            return ;
        }
        
        maze[row][col] = -1;
        
        getAns(maze,row-1,col,path+"U",ans);
        getAns(maze,row+1,col,path+"D",ans);
        getAns(maze,row,col-1,path+"L",ans);
        getAns(maze,row,col+1,path+"R",ans);
        
        maze[row][col] = 1;
    }
    
    vector<string> ratInMaze(vector<vector<int>>& maze) {
        int n=maze.size();
        vector<string> ans;
        
        if(maze[0][0] == 0){
            return ans;
        }
        
        getAns(maze,0,0,"",ans);
        
        sort(ans.begin(),ans.end());
        
        return ans;
    }
};
